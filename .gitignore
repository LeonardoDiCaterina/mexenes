# Data files (Never commit raw or synthetic laboratory data)
data/*
!data/.gitkeep
data_real/
data_real/*
*.xy
*.dat
*.chi

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
._*

# Virtual environments
.env
.venv/
env/
venv/

# Output directory (ignore all generated artifacts)
output/*
!output/.gitkeep

# Academic papers & PDFs
papers/
*.pdf
